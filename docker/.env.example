# Obsidian Sync Server Configuration
# Copy this to .env and customize

# Core
OSS_SECRET_KEY=change-me-to-a-random-string
OSS_DEBUG=false

# Deployment mode: "self_hosted" or "saas"
OSS_DEPLOYMENT_MODE=self_hosted

# Database (SQLite for self-hosted, PostgreSQL for SaaS)
OSS_DATABASE_URL=sqlite+aiosqlite:////app/data/obsidian-sync.db
# OSS_DATABASE_URL=postgresql+asyncpg://user:password@db:5432/obsidian_sync

# Storage
OSS_STORAGE_BACKEND=local
OSS_STORAGE_LOCAL_PATH=/app/data/vaults
# OSS_S3_BUCKET=your-bucket
# OSS_S3_REGION=us-east-1

# OAuth (optional)
# OSS_GOOGLE_CLIENT_ID=
# OSS_GOOGLE_CLIENT_SECRET=
# OSS_GITHUB_CLIENT_ID=
# OSS_GITHUB_CLIENT_SECRET=

# Stripe (SaaS mode only)
# OSS_STRIPE_SECRET_KEY=sk_...
# OSS_STRIPE_WEBHOOK_SECRET=whsec_...

# Caddy domain (for TLS)
# DOMAIN=sync.yourdomain.com
